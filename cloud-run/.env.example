# Local data directory
STOCKDATA_CACHE_DIR=/cache

# Server port (Cloud Run sets this automatically)
PORT=8080

# Optional: only needed to override main.py's own defaults for the
# merged tickreplay app it now mounts (loopback server URL, and a cache
# dir under this server's own jp root so files are not downloaded twice).
BACKCAST_DUCKDB_CACHE_DIR=/cache/jp
BACKCAST_DUCKDB_SERVER_URL=http://127.0.0.1:8080
