# Local data directory
STOCKDATA_CACHE_DIR=/cache

# Server port (Cloud Run sets this automatically)
PORT=8080

# Optional: only needed to override main.py's own defaults for the merged
# tickreplay app. Because the two defaults below are written explicitly here,
# also declare that this cache is the file server's own authoritative jp root.
BACKCAST_DUCKDB_CACHE_DIR=/cache/jp
BACKCAST_DUCKDB_SERVER_URL=http://127.0.0.1:8080
BACKCAST_DUCKDB_LOCAL_AUTHORITATIVE=true
