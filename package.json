{
  "name": "backcast-strategy-assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": "12.0.1"
  },
  "scripts": {
    "build:strategy-editor": "node scripts/build_strategy_editor.mjs",
    "check:strategy-editor": "node scripts/build_strategy_editor.mjs --check",
    "check:strategy-config": "node scripts/build_strategy_release.mjs --check-config tests/browser/strategy-assets.mjs",
    "build:strategy-release": "node scripts/build_strategy_release.mjs --write",
    "check:strategy-release": "node scripts/build_strategy_release.mjs --check",
    "test:strategy-assets": "node --test tests/browser/strategy-assets.test.mjs tests/browser/strategy-release.test.mjs",
    "test:strategy-browser": "playwright test --config tests/browser/playwright.config.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
